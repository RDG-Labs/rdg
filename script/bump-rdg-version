#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <new-version>" >&2
  exit 1
fi

new_version="$1"

python3 - "$new_version" <<'PY'
import re
import sys
from pathlib import Path

new_version = sys.argv[1]
pattern = re.compile(r'(?m)(^name = "rdg"\nversion = ")[^"]+("$)')
for filename in ("crates/rdg/Cargo.toml", "Cargo.lock"):
    path = Path(filename)
    content = path.read_text()
    updated, count = pattern.subn(rf"\g<1>{new_version}\g<2>", content)
    if count != 1:
        raise SystemExit(f"expected one rdg package version in {filename}, found {count}")
    path.write_text(updated)
PY